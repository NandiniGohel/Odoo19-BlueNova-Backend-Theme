<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="theme_import_wizard_view_form" model="ir.ui.view">
        <field name="name">bluenova.theme.import.wizard.form</field>
        <field name="model">bluenova.theme.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Theme Settings">
                <group>
                    <field name="preset_filename" invisible="1"/>
                    <field name="preset_file"
                           widget="binary"
                           filename="preset_filename"
                           string="Preset File"/>
                </group>
                <div class="text-muted">
                    Upload a JSON file produced by Export Settings. Every colour
                    in the preset replaces the current one; colours the preset
                    leaves empty go back to the theme defaults. Images are not
                    part of a preset and are left untouched.
                </div>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
