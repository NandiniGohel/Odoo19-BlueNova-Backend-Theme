<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        The persistent app rail. Lists the same apps Odoo's dropdown lists
        (menuService.getApps()), each with its bundled icon from
        static/src/image/icons, and highlights the one currently open.

        OWL 2 markup: `this` is the AppsSidebar component, clicks are
        `t-on-*` handlers, and every t-foreach carries a t-key (mandatory
        since OWL 2 — the 14.0 QWeb2 version had none).

        Hidden below the md breakpoint: on small screens Odoo keeps its own
        apps menu, which we leave in place and untouched.
    -->
    <t t-name="bluenova_backend_theme.AppsSidebar">
        <nav class="cmt-app-sidebar d-none d-md-flex"
             t-att-class="{ 'cmt-app-sidebar--closed': !sidebar.open }"
             aria-label="Applications">

            <!-- Workspace header: active company + database -->
            <div class="cmt-app-sidebar__workspace">
                <span class="cmt-app-sidebar__workspace-icon"
                      t-attf-style="--cmt-icon-url: url('{{ workspaceIcon }}')"/>
                <div class="cmt-app-sidebar__workspace-text">
                    <span class="cmt-app-sidebar__workspace-name" t-esc="workspace.name"/>
                    <span class="cmt-app-sidebar__workspace-sub" t-esc="workspace.subtitle"/>
                </div>
            </div>

            <!-- App list -->
            <ul class="cmt-app-sidebar__apps">
                <li t-foreach="apps" t-as="app" t-key="app.id">
                    <t t-set="icon" t-value="getIcon(app)"/>
                    <a class="cmt-app-sidebar__app"
                       t-att-class="{ 'cmt-app-sidebar__app--active': app.id === currentAppId }"
                       t-att-href="getHref(app)"
                       t-att-title="app.name"
                       t-att-data-menu-xmlid="app.xmlid"
                       t-att-data-menu-id="app.id"
                       t-on-click="(ev) => this.onAppClick(ev, app)">
                        <!--
                            Bundled artwork is single-colour, so it is painted
                            through a CSS mask: the colour then lives in the
                            stylesheet and can follow hover / active state.
                            Anything falling back to Odoo's own icon is
                            full-colour and has to be drawn as a plain image.
                        -->
                        <span t-if="icon.bundled"
                              class="cmt-app-sidebar__app-icon cmt-app-sidebar__app-icon--bundled"
                              t-attf-style="--cmt-icon-url: url('{{ icon.src }}')"/>
                        <img t-else=""
                             class="cmt-app-sidebar__app-icon cmt-app-sidebar__app-icon--native"
                             t-att-src="icon.src"
                             t-on-error="() => this.onIconError(app)"
                             alt=""/>
                        <span class="cmt-app-sidebar__app-label" t-esc="app.name"/>
                    </a>
                </li>
            </ul>

            <!-- Light / dark switch -->
            <div class="cmt-app-sidebar__footer">
                <button type="button"
                        class="cmt-theme-toggle"
                        t-att-title="themeToggleTitle"
                        t-att-aria-label="themeToggleTitle"
                        t-att-aria-pressed="themeMode.mode === 'dark' ? 'true' : 'false'"
                        t-on-click="onThemeToggleClick">
                    <i class="cmt-theme-toggle__icon fa"
                       t-att-class="themeMode.mode === 'dark' ? 'fa-sun-o' : 'fa-moon-o'"
                       role="img"/>
                    <span class="cmt-theme-toggle__label" t-esc="themeToggleLabel"/>
                </button>
            </div>
        </nav>
    </t>

    <!--
        Mount point. The rail sits next to the navbar inside the WebClient,
        under the same `t-if` so both stand down when an action goes
        fullscreen. AppsSidebar is added to WebClient.components in
        js/apps_sidebar_patch.js — a template alone cannot introduce a
        component tag.
    -->
    <t t-name="bluenova_backend_theme.WebClient"
       t-inherit="web.WebClient"
       t-inherit-mode="extension">
        <xpath expr="//NavBar" position="after">
            <AppsSidebar/>
        </xpath>
    </t>

    <!--
        The switch. Placed straight after Odoo's own apps menu so the two
        read as one control group; core's menu is left in place and keeps
        working below the md breakpoint, where the rail is hidden.

        `d-none d-md-flex` mirrors the rail's own breakpoint — a button that
        toggles something invisible is worse than no button.
    -->
    <t t-name="bluenova_backend_theme.NavBar"
       t-inherit="web.NavBar"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="after">
            <button type="button"
                    class="cmt-apps-toggle d-none d-md-flex"
                    accesskey="h"
                    title="Applications"
                    aria-label="Toggle applications sidebar"
                    t-att-aria-expanded="cmtSidebarOpen ? 'true' : 'false'"
                    t-att-class="{ 'cmt-apps-toggle--active': cmtSidebarOpen }"
                    t-on-click="onCmtAppsToggleClick">
                <i class="fa fa-th-large" role="img"/>
            </button>
        </xpath>
    </t>

</templates>
