<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Stats banner OWL component template.
        Renders 4 summary cards; hidden when isVisible is false or stats
        is null (e.g. ungrouped kanban, empty pipeline, data-structure mismatch).
    -->
    <t t-name="bluenova_backend_theme.PipelineStats">
        <div t-if="isVisible and stats" class="cmt-stats-banner">
            <!-- Card 1 — first pipeline stage -->
            <div class="cmt-stat-card cmt-stat-card--new">
                <span class="cmt-stat-card__label" t-esc="stats.newLeads.label"/>
                <span class="cmt-stat-card__value" t-esc="stats.newLeads.count"/>
                <span class="cmt-stat-card__sub" t-esc="stats.newLeads.sub"/>
            </div>

            <!-- Card 2 — second pipeline stage -->
            <div class="cmt-stat-card cmt-stat-card--qualified">
                <span class="cmt-stat-card__label" t-esc="stats.qualified.label"/>
                <span class="cmt-stat-card__value" t-esc="stats.qualified.count"/>
                <span class="cmt-stat-card__sub" t-esc="stats.qualified.sub"/>
            </div>

            <!-- Card 3 — expected revenue across the whole pipeline -->
            <div class="cmt-stat-card cmt-stat-card--revenue">
                <span class="cmt-stat-card__label">Proposition</span>
                <span class="cmt-stat-card__value" t-esc="stats.revenue.formatted"/>
                <span class="cmt-stat-card__sub" t-esc="stats.revenue.sub"/>
            </div>

            <!-- Card 4 — won deals + conversion -->
            <div class="cmt-stat-card cmt-stat-card--won">
                <span class="cmt-stat-card__label">Won Deals</span>
                <span class="cmt-stat-card__value" t-esc="stats.wonDeals.count"/>
                <span class="cmt-stat-card__sub" t-esc="stats.wonDeals.sub"/>
            </div>
        </div>
    </t>

    <!--
        Extended kanban renderer template (primary mode = new template,
        does NOT modify the original web.KanbanRenderer used by other views).

        Inserts the CrmPipelineStats component as a sibling BEFORE the
        .o_kanban_renderer div so it sits above the pipeline columns.
        kanban.scss turns .o_content into a flex column so the banner
        stays pinned and only the board scrolls.
    -->
    <t t-name="bluenova_backend_theme.CrmKanbanRenderer"
       t-inherit="web.KanbanRenderer"
       t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="before">
            <CrmPipelineStats list="props.list"/>
        </xpath>
    </t>

</templates>
